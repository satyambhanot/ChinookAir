        <mxCell id="n1" value="All packages are under ca.ucalgary.chinookair. Nothing in presentation imports from data: the views call controllers only. The business.control classes use the data layer only through the DAO interfaces, DaoFactory and ConfirmationWriter, never a Sqlite class. business.entity depends on nothing but the JDK." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="740" width="420" height="115" as="geometry"/></mxCell>
        <mxCell id="n2" value="+ public    ~ package-private    italic = interface or abstract class&#10;An arrow means &quot;depends on (imports)&quot;." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="880" width="420" height="70" as="geometry"/></mxCell>
